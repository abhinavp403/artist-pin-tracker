<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 30 and below. API 31+ reads data_extraction_rules.xml instead, and the
   two files have to agree — see the comment there for why the session is excluded.
-->
<full-backup-content>
    <!-- Supabase keeps the refresh token in the default SharedPreferences file
         (dev.abhinav.artistpin_preferences.xml, via multiplatform-settings). Backing that up ships
         a live credential to Google Drive. Everything else — the Room database, DataStore
         settings — still backs up; excluding this only means signing in again after a restore,
         which is what a restore does anyway. -->
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>
