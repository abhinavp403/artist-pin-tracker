<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's blue, with two faint rings spreading from where the pin's tip lands, so the plate
  reads as a map rather than a flat square. The rings run past the edges on purpose: whatever
  shape a launcher masks the icon into, they still look like they carry on underneath it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF1C5F9C" android:offset="0.0" />
                <item android:color="#FF14497A" android:offset="0.55" />
                <item android:color="#FF0C2E4F" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M54,76.5m-24,0a24,24 0 1,0 48,0a24,24 0 1,0 -48,0"
        android:fillColor="#00000000"
        android:strokeWidth="1.6"
        android:strokeColor="#26FFFFFF" />
    <path
        android:pathData="M54,76.5m-38,0a38,38 0 1,0 76,0a38,38 0 1,0 -76,0"
        android:fillColor="#00000000"
        android:strokeWidth="1.6"
        android:strokeColor="#1AFFFFFF" />
</vector>
